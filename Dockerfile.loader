FROM python@sha256:a83ba18aef0f865b1a4a611c2cf460fe446f2795673bbb9fe43be570439e3b39

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/home/app \
    HF_HOME=/models \
    HF_HUB_DISABLE_TELEMETRY=1

RUN groupadd --gid 10001 app && \
    useradd --uid 10001 --gid 10001 \
    --home-dir /home/app --create-home app && \
    mkdir -p /app && \
    chown -R 10001:10001 /app

COPY requirements-loader.txt /app/requirements-loader.txt

RUN python -m pip install --no-cache-dir \
    -r /app/requirements-loader.txt

COPY --chown=10001:10001 scripts/download_model.py /app/download_model.py

WORKDIR /app

USER 10001:10001

ENTRYPOINT ["python", "/app/download_model.py"]